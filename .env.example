# --- Telegram (founder account: create via @BotFather) ---
BOT_TOKEN=
# Random string; Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=change-me-random

# --- AI layer (any OpenAI-compatible provider; founder account) ---
AI_BASE_URL=https://api.mistral.ai/v1
AI_API_KEY=
AI_MODEL=mistral-medium-latest

# --- Defaults for NEW users (per-user values afterwards; editable in-chat) ---
DEFAULT_TIMEZONE=Asia/Kolkata
MEAL_BREAKFAST=08:00
MEAL_LUNCH=14:00
MEAL_DINNER=19:00
OFFSET_BEFORE_MIN=-15
OFFSET_AFTER_MIN=45

# --- Engine / limits ---
TICK_SECONDS=900
REMINDER_WINDOW_MIN=180
MAX_SEND_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=30
MAX_DURATION_DAYS=90
CONVERSATION_TTL_MIN=30

# --- Storage / ops ---
DB_PATH=remed.db
LOG_LEVEL=INFO
