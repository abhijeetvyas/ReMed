# --- Telegram (founder account: create via @BotFather) ---
BOT_TOKEN=
# Random string; Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=change-me-random

# --- AI layer (OpenAI-compatible endpoint; founder account) ---
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Fallback chain, tried in order; falls through on 429/5xx/timeouts.
# Must stay in sync with per-model rate limits. Leave empty for the built-in default.
AI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# --- Defaults for NEW users (per-user values afterwards; editable in-chat) ---
DEFAULT_TIMEZONE=Asia/Kolkata
MEAL_BREAKFAST=08:00
MEAL_LUNCH=14:00
MEAL_DINNER=19:00
OFFSET_BEFORE_MIN=-15
OFFSET_AFTER_MIN=45

# --- Engine / limits ---
TICK_SECONDS=900
REMINDER_WINDOW_MIN=180
MAX_SEND_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=30
MAX_DURATION_DAYS=90
CONVERSATION_TTL_MIN=30

# --- Storage / ops ---
DB_PATH=remed.db  # in containers this MUST be an absolute path (e.g. /data/remed.db) or data won't hit the volume
LOG_LEVEL=INFO
